# Copy to server/.env (the root "npm install" does this for you automatically).
PORT=5000
# Local MongoDB, or paste a MongoDB Atlas connection string (mongodb+srv://user:pass@cluster/book_store)
MONGODB_URI=mongodb://127.0.0.1:27017/book_store
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Allowed browser origin(s) for CORS, comma separated
CLIENT_URL=http://localhost:5173

# Used ONLY by "npm run seed" to create the first admin. Choose your own values.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
